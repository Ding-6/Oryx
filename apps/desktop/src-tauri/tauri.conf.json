{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oryx",
  "version": "0.1.0",
  "identifier": "com.oryx.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Oryx",
        "width": 1520,
        "height": 940,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "操作系统级 AI 助手",
    "longDescription": "用一句话操控电脑：文件检索、系统信息、网页操作，破坏性动作先确认。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../../../core/oryx": "core/oryx",
      "../../../core/web": "core/web",
      "../../../core/scripts": "core/scripts",
      "../../../skills": "skills",
      "../../../experts": "experts",
      "../../../agents": "agents"
    }
  }
}
